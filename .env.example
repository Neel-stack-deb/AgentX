# Memory backends: inmemory | postgres / inmemory | pgvector
MEMORY_STORE=inmemory
VECTOR_STORE=inmemory

# PostgreSQL (local docker-compose defaults)
DATABASE_URL=postgresql://agentx:agentx@localhost:5432/agentx
PGVECTOR_TABLE=agentx_memories
PGVECTOR_INDEX_MODE=hnsw
PGVECTOR_DISTANCE=cosine
PGVECTOR_HNSW_EF_SEARCH=40

PG_POOL_MIN_SIZE=1
PG_POOL_MAX_SIZE=10
PG_POOL_TIMEOUT_SECONDS=30

# Must match HashEmbeddingProvider / production model output width for pgvector column + HNSW
EMBEDDING_DIMENSION=64

# Integration tests: set to 1 when Postgres is running
AGENTX_PG_INTEGRATION=0
